<h1 class="page-title">Editar {{product.name}}</h1>

<form action="/products/edit" method="post">

    <input type="hidden" name="id" value="{{product._id}}">

    <div class="form-control">
        <label for="name">Nome do produto:</label>
        <input type="text" name="name" value="{{product.name}}" placeholder="Digite o nome do produto">
    </div>
    <div class="form-control">
        <label for="image">Imagem do produto:</label>
        <input type="text" name="image" value="{{product.image}}" placeholder="insira a URL da imagem">
    </div>
    <div class="form-control">
        <label for="price">Preço do produto (R$):</label>
        <input type="number" name="price" value="{{product.price}}" placeholder="Digite o preço do produto">
    </div>
    <div class="form-control">
        <label for="description">Descrição:</label>
        <textarea name="description" placeholder="descrição do produto">{{product.description}}</textarea>
    </div>
    <input type="submit" value="Salvar" class="btn">

</form>