<h1 class="page-title">Products</h1>

<div class="products">
    {{#each products}}
    <div class="product">
        <img src="{{this.image}}" alt="{{this.name}}">
        <h5> {{this.name}} </h5>
        <p> R$ {{this.price}} </p>
        <a href="/products/{{this._id}}">Ver detalhes</a>
    </div>
    {{/each}}
</div>